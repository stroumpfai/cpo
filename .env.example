# Copy to .env and set values before starting the application.
# .env is gitignored — never commit it.

# REQUIRED: JWT secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins.
# Leave empty in production (frontend is served from same origin).
# Example for local dev: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# Comma-separated IPs/CIDRs of trusted reverse proxies (nginx, Traefik, etc.).
# When set, X-Forwarded-For is used for rate limiting instead of the proxy IP.
# Leave empty if running without a reverse proxy.
TRUSTED_PROXY=

# Version shown in the UI (CPO sidebar, admin header). Both are build args:
# set them, then `docker compose build`. Empty is fine — the build falls back
# to "dev" / "unknown".
# APP_VERSION is used verbatim, so set the whole string to display (e.g. 1.5.0).
APP_VERSION=
# Short commit for the version tooltip: $(git rev-parse --short HEAD)
GIT_COMMIT=

# Override the baked-in version at runtime — takes effect on restart, without a
# rebuild. Keep these COMMENTED OUT unless you are using them: unlike the build
# args above, an empty value here is passed straight into the container and
# blanks the version out instead of falling back.
#CPO_VERSION=
#CPO_COMMIT=

# Paths (defaults match Docker volume mounts)
CONFIG_PATH=/app/config/config.json
DATA_DIR=/app/data
