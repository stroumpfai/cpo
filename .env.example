# Copy to .env and set values before starting the application.
# .env is gitignored — never commit it.

# REQUIRED: JWT secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins.
# Leave empty in production (frontend is served from same origin).
# Example for local dev: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# Paths (defaults match Docker volume mounts)
CONFIG_PATH=/app/config/config.json
DATA_DIR=/app/data
